PORT=5000
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
MONGODB_URI=mongodb://localhost:27017/prepai

# Brevo (Sendinblue) Configuration for Email OTP (Recommended for Render & Production)
# 1. Sign up for free at https://www.brevo.com (300 free emails/day)
# 2. Add and verify your sender email under "Senders, Domains & Dedicated IPs" -> "Senders"
# 3. Generate an API Key under Account -> "SMTP & API" -> "API Keys"
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@gmail.com
BREVO_SENDER_NAME=PrepAI Security

# (Optional Fallback) Gmail SMTP Configuration for Email OTP
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_SERVICE=gmail
